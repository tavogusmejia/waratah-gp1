{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,

  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 7 * * *"
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "comment": "2.8 MB of extracted pictures with no policy at all until now. NOT immutable: these filenames are slugs, not content hashes, so a re-extract reuses the name and a year-long cache would hide the new picture from everyone who had seen the old one. A day hard, a week stale-while-revalidate - the visitor gets it instantly and the browser refreshes behind them. Hashing the names (backlog #48) is what would make immutable safe.",
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
